{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "jsx": "react-native",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "index.js"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "android-native"
  ]
}
