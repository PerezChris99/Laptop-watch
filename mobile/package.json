{
  "name": "laptopwatch-mobile",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test:protocol": "node --test tests/*.test.js",
    "lint": "eslint . --max-warnings=0",
    "check:tokens": "python ../design/generate.py --check",
    "check:js": "tsc --noEmit --project jsconfig.json",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "npm run test:protocol && npm run test:ui",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "start": "react-native start",
    "test:ui": "jest --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "1.8.0",
    "base64-js": "1.5.1",
    "prop-types": "15.8.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "2.0.0",
    "react-native-keychain": "11.0.0",
    "react-native-url-polyfill": "2.0.0",
    "@op-engineering/op-sqlite": "18.2.5",
    "react-native-webrtc": "155.0.1",
    "react-native-camera-kit": "18.0.1",
    "react-native-permissions": "5.6.3",
    "react-native-video": "6.19.3",
    "react-native-safe-area-context": "5.6.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@testing-library/react-native": "13.3.3",
    "eslint": "9.39.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-security": "4.2.1",
    "jest": "30.2.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "@babel/core": "7.26.9",
    "@babel/runtime": "7.26.9",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/jest-preset": "0.88.1",
    "react-test-renderer": "19.3.0",
    "@types/react": "19.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
