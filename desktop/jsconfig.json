{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src-ui/**/*.js",
    "src-ui/**/*.jsx",
    "src/**/*.js",
    "vite.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src-tauri"
  ]
}
