<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production client never permits unauthenticated HTTP/PIN fallback.
         Private LAN hosts use certificate fingerprint pinning at pairing. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
