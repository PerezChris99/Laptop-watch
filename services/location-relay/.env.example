# Explicitly configure a domain under your control and point its DNS to this host.
# Public HTTPS is handled by Caddy; never expose relay:8080 on the host.
RELAY_DOMAIN=relay.example.invalid

# Optional Firebase project ID for generic owner-notification hints; keep
# empty to run signed GPS / incident relay without third-party FCM.
LAPTOPWATCH_FIREBASE_PROJECT_ID=
# The relay NEVER includes credentials in source control.
# Use cloud workload identity or a secure owner-managed Compose override.
