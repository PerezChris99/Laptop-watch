# Set from an operator-controlled secrets manager. NEVER commit actual values.
LW_BILLING_DB=/var/lib/laptopwatch-billing/billing.sqlite3
LW_BILLING_PORT=8899
LW_PADDLE_WEBHOOK_SECRET=replace-with-Paddle-notification-destination-secret
LW_CHECKOUT_TICKET_SECRET=replace-with-random-64+-char-secret
LW_BILLING_OPERATOR_SECRET=replace-with-random-64+-char-secret
LW_LICENSE_SIGNING_KEY_FILE=/run/secrets/lw_issuer_ed25519.pem
LW_PADDLE_PRICE_PRO=pri_replace_with_actual_recurring_price_id
LW_PADDLE_PRICE_BUSINESS=pri_replace_with_actual_recurring_price_id
LW_PADDLE_API_KEY=replace-with-server-side-Paddle-API-key
LW_PADDLE_SANDBOX=true
